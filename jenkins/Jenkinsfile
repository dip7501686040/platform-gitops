// CI only — checks out the ai-notification-system source repo, builds and
// pushes images, then bumps each service's image.tag in
// k8s/environments/<env>/values-<service>.yaml (in *this* repo,
// platform-gitops) and pushes that commit. ArgoCD's existing auto-sync (see
// k8s/argocd) picks up the change and does the actual deploy — this
// pipeline never touches the cluster directly.
//
// Two repos, two roles: this Jenkinsfile lives in platform-gitops (deploy
// config — Terraform, Helm/k8s, ArgoCD, this pipeline), which is also the
// SCM Jenkins implicitly checks out as the job workspace. The source repo
// (application code) is checked out separately, into src/, purely to get
// code and Dockerfiles for the image builds. Both repos are public; the
// split is about keeping deploy concerns out of the app repo, not access
// control — see the tag-bump push step below for the one place that still
// needs a credential (write access).
//
// Builds via kaniko, not `docker build`/`docker push` directly: Jenkins now
// runs as a Kubernetes pod itself (see k8s/jenkins/values.yaml), and the k3s
// node it schedules onto has no docker.sock to give a build agent — kaniko
// is the standard way to build/push images from inside a pod with no Docker
// daemon at all. One kaniko pod at a time, not batched/parallel: this
// project's whole Floci-based local environment has repeatedly shown it
// can't absorb concurrent load (see platform-infrastructure/main.tf's own
// sequencing comments) — simpler and safer than the previous batches-of-2
// scheme.

def SOURCE_REPO_URL = 'https://github.com/dip7501686040/ai-notification-system.git'
def SOURCE_BRANCH = 'main'

def SERVICE_CATALOG = [
  'identity-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/identity-service', APP_DIR: 'identity-service'],
  ],
  'tenant-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/tenant-service', APP_DIR: 'tenant-service'],
  ],
  'event-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/event-service', APP_DIR: 'event-service'],
  ],
  'rule-engine-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/rule-engine-service', APP_DIR: 'rule-engine-service'],
  ],
  'template-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/template-service', APP_DIR: 'template-service'],
  ],
  'notification-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/notification-service', APP_DIR: 'notification-service'],
  ],
  'channel-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/channel-service', APP_DIR: 'channel-service'],
  ],
  'ai-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/ai-service', APP_DIR: 'ai-service'],
  ],
  'analytics-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/analytics-service', APP_DIR: 'analytics-service'],
  ],
  'audit-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/audit-service', APP_DIR: 'audit-service'],
  ],
  'api-gateway': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/api-gateway', APP_DIR: 'api-gateway'],
  ],
  // web is deliberately last — its NEXT_PUBLIC_API_URL build-arg is baked
  // in at image build time and should point at api-gateway's real external
  // URL once one exists.
  'web': [
    dockerfile: 'src/docker/web-service.Dockerfile', context: 'src',
    buildArgs: [NEXT_PUBLIC_API_URL: params.WEB_API_URL ?: 'http://localhost:8000'],
  ],
  'prediction-service': [
    dockerfile: 'src/apps/prediction-service/Dockerfile', context: 'src/apps/prediction-service',
    buildArgs: [:],
  ],
]

// Order matches the previous batching scheme's sequence, just flattened —
// no service depends on another's build finishing first, this is purely
// cosmetic continuity with the original rollout plan.
def BUILD_ORDER = [
  'identity-service', 'tenant-service', 'event-service', 'rule-engine-service',
  'template-service', 'notification-service', 'channel-service', 'ai-service',
  'analytics-service', 'audit-service', 'api-gateway', 'web', 'prediction-service',
]

pipeline {
  agent {
    kubernetes {
      yaml '''
        apiVersion: v1
        kind: Pod
        spec:
          containers:
          - name: kaniko
            image: gcr.io/kaniko-project/executor:v1.23.2-debug
            command: ["sleep"]
            args: ["99d"]
            resources:
              requests: { cpu: 100m, memory: 256Mi }
              limits: { cpu: 500m, memory: 512Mi }
      '''
      defaultContainer 'jnlp'
    }
  }

  parameters {
    choice(name: 'ENVIRONMENT', choices: ['local', 'prod'], description: 'Which k8s/environments/<env> to update')
    string(name: 'SERVICES', defaultValue: 'identity-service', description: 'Comma-separated service names, or "all"')
    string(name: 'WEB_API_URL', defaultValue: '', description: 'Overrides web\'s NEXT_PUBLIC_API_URL build-arg')
  }

  stages {
    stage('Checkout source repo') {
      steps {
        // Public repo — anonymous clone, no credential needed for read.
        dir('src') {
          git branch: SOURCE_BRANCH, url: SOURCE_REPO_URL
        }
      }
    }

    stage('Load environment') {
      steps {
        // Plain shell parsing rather than the readProperties step, to avoid
        // needing the pipeline-utility-steps plugin on top of the minimal
        // plugin set this setup needs.
        script {
          def propsFile = "jenkins/env/${params.ENVIRONMENT}.properties"
          env.AWS_REGION   = sh(script: "grep '^AWS_REGION='   ${propsFile} | cut -d= -f2-", returnStdout: true).trim()
          env.ECR_REGISTRY = sh(script: "grep '^ECR_REGISTRY=' ${propsFile} | cut -d= -f2-", returnStdout: true).trim()
          env.K8S_ENV       = sh(script: "grep '^K8S_ENV='      ${propsFile} | cut -d= -f2-", returnStdout: true).trim()
          // The image tag must track the *source* repo's commit, not this
          // (platform-gitops) repo's — GIT_COMMIT here would be the latter.
          env.GIT_SHA = sh(script: "git -C src rev-parse --short=8 HEAD", returnStdout: true).trim()
        }
        // Local (not --global) repo config, set once — needed by every git
        // operation that creates a commit, including the rebase replay in
        // the push-retry loop below, not just the explicit `git commit`
        // call (confirmed: a per-command `-c user.name=...` on just the
        // commit step left `git rebase` with no identity when a concurrent
        // push forced a retry, failing with "unable to auto-detect email").
        sh '''
          git config user.name jenkins
          git config user.email jenkins@ai-notification.local
        '''
      }
    }

    stage('Build + push (kaniko, one service at a time)') {
      steps {
        script {
          def requested = params.SERVICES.trim() == 'all'
            ? SERVICE_CATALOG.keySet()
            : params.SERVICES.split(',').collect { it.trim() }

          for (svc in BUILD_ORDER) {
            if (!requested.contains(svc)) {
              continue
            }
            def cfg = SERVICE_CATALOG[svc]
            def image = "${env.ECR_REGISTRY}/${svc}:${env.GIT_SHA}"
            // kaniko's --dockerfile is relative to --context, not the
            // workspace root (docker build's -f is workspace-root-relative)
            // -- every catalog entry's dockerfile path already starts with
            // its own context path, so strip that prefix.
            def dockerfileInContext = cfg.dockerfile.substring(cfg.context.length() + 1)
            def buildArgFlags = cfg.buildArgs.collect { k, v -> "--build-arg=${k}=${v}" }.join(' ')

            container('kaniko') {
              // --insecure/--insecure-pull/--skip-tls-verify: Floci's ECR
              // emulation is a plain unauthenticated HTTP registry (see
              // jenkins/env/local.properties) -- fine for local, but this
              // is NOT how prod's real ECR (proper HTTPS + IAM auth) should
              // be pushed to. Deliberately not handled yet -- prod-only
              // work is deferred until prod is actually being set up.
              sh """
                /kaniko/executor \
                  --context=dir://\${WORKSPACE}/${cfg.context} \
                  --dockerfile=${dockerfileInContext} \
                  ${buildArgFlags} \
                  --destination=${image} \
                  --insecure --insecure-pull --skip-tls-verify
              """
            }

            def valuesFile = "k8s/environments/${env.K8S_ENV}/values-${svc}.yaml"
            sh """
              sed -i "s|^\\(\\s*repository:\\).*|\\1 ${env.ECR_REGISTRY}/${svc}|" ${valuesFile}
              sed -i "s|^\\(\\s*tag:\\).*|\\1 \\"${env.GIT_SHA}\\"|" ${valuesFile}
              git add ${valuesFile}
              git commit -m "ci: bump image tag for ${svc} to ${env.GIT_SHA}"
            """
          }
        }
      }
    }

    stage('Push tag-bump commits') {
      steps {
        // github-push credential is seeded automatically into Jenkins' own
        // credential store at startup (see k8s/jenkins/values.yaml's
        // initScripts) — nothing manual needed here.
        //
        // Rebase-and-retry rather than a bare push: this branch can move
        // between checkout and push (another build, or a human pushing
        // directly), so a bare push racing that would fail outright.
        withCredentials([usernamePassword(credentialsId: 'github-push', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
          sh '''
            REMOTE="https://${GIT_USER}:${GIT_TOKEN}@github.com/dip7501686040/platform-gitops.git"
            for attempt in 1 2 3 4 5; do
              if git push "$REMOTE" HEAD:main; then
                exit 0
              fi
              echo "push rejected (attempt $attempt) — rebasing onto latest main and retrying"
              git fetch "$REMOTE" main
              git rebase FETCH_HEAD
            done
            echo "push still failing after 5 attempts"
            exit 1
          '''
        }
      }
    }
  }
}
