// CI only — checks out the ai-notification-system source repo, builds and
// pushes images, then bumps each service's image.tag in
// k8s/environments/<env>/values-<service>.yaml (in *this* repo,
// platform-gitops) and pushes that commit. ArgoCD's existing auto-sync (see
// k8s/argocd) picks up the change and does the actual deploy — this
// pipeline never touches the cluster directly.
//
// Two repos, two roles: this Jenkinsfile lives in platform-gitops (deploy
// config — Terraform, Helm/k8s, ArgoCD, this pipeline), which is also the
// SCM Jenkins implicitly checks out as the job workspace. The source repo
// (application code) is checked out separately, into src/, purely to get
// code and Dockerfiles for the image builds. Both repos are public; the
// split is about keeping deploy concerns out of the app repo, not access
// control — see the tag-bump push step below for the one place that still
// needs a credential (write access).
//
// Builds with plain `docker build` against the host Docker daemon, whose
// socket is bind-mounted into this Jenkins container (see
// platform-infrastructure/main.tf's `--- jenkins ---` section and
// templates/jenkins/Dockerfile). Jenkins used to run as a k8s pod with no
// docker.sock, which is why the previous version of this file shelled out
// to kaniko in a k8s build agent — that whole constraint is gone now
// (plain container + mounted socket), and `docker build` handles the app's
// BuildKit Dockerfiles (`# syntax=`, `RUN --mount=type=cache`) natively,
// which kaniko does not. One service at a time, never parallel: this
// project's local Floci environment has repeatedly shown it can't absorb
// concurrent load (see platform-infrastructure/main.tf's sequencing notes).
//
// Every image is pushed to TWO registries:
//   1. the Floci ECR emulator — pushed via ${ECR_PUSH_REGISTRY} (its
//      published host port), recorded in values-*.yaml as ${ECR_REGISTRY}
//      (the in-cluster pull address). What ArgoCD deploys from locally;
//      wiped whenever the Floci containers are torn down.
//   2. Docker Hub — ${DOCKERHUB_REPO}:<svc>-<sha>, one shared public repo.
//      A durable off-box copy so a Floci wipe doesn't force a rebuild of
//      all 13 services. Not referenced by any manifest; purely a cache.

def SOURCE_REPO_URL = 'https://github.com/dip7501686040/ai-notification-system.git'
def SOURCE_BRANCH = 'main'

def SERVICE_CATALOG = [
  'identity-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/identity-service', APP_DIR: 'identity-service'],
  ],
  'tenant-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/tenant-service', APP_DIR: 'tenant-service'],
  ],
  'event-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/event-service', APP_DIR: 'event-service'],
  ],
  'rule-engine-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/rule-engine-service', APP_DIR: 'rule-engine-service'],
  ],
  'template-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/template-service', APP_DIR: 'template-service'],
  ],
  'notification-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/notification-service', APP_DIR: 'notification-service'],
  ],
  'channel-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/channel-service', APP_DIR: 'channel-service'],
  ],
  'ai-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/ai-service', APP_DIR: 'ai-service'],
  ],
  'analytics-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/analytics-service', APP_DIR: 'analytics-service'],
  ],
  'audit-service': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/audit-service', APP_DIR: 'audit-service'],
  ],
  'api-gateway': [
    dockerfile: 'src/docker/nest-service.Dockerfile', context: 'src',
    buildArgs: [APP_NAME: '@ai-notification/api-gateway', APP_DIR: 'api-gateway'],
  ],
  // web is deliberately last — its NEXT_PUBLIC_API_URL build-arg is baked
  // in at image build time and should point at api-gateway's real external
  // URL once one exists.
  'web': [
    dockerfile: 'src/docker/web-service.Dockerfile', context: 'src',
    buildArgs: [NEXT_PUBLIC_API_URL: params.WEB_API_URL ?: 'http://localhost:8000'],
  ],
  'prediction-service': [
    dockerfile: 'src/apps/prediction-service/Dockerfile', context: 'src/apps/prediction-service',
    buildArgs: [:],
  ],
]

// Order matches the previous batching scheme's sequence, just flattened —
// no service depends on another's build finishing first, this is purely
// cosmetic continuity with the original rollout plan.
def BUILD_ORDER = [
  'identity-service', 'tenant-service', 'event-service', 'rule-engine-service',
  'template-service', 'notification-service', 'channel-service', 'ai-service',
  'analytics-service', 'audit-service', 'api-gateway', 'web', 'prediction-service',
]

pipeline {
  // Runs on the Jenkins controller itself — a plain container with the
  // `docker` CLI and the host daemon socket mounted (no k8s build agents).
  agent any

  environment {
    // The app Dockerfiles use BuildKit-only syntax (`# syntax=`,
    // `RUN --mount=type=cache`). The image ships the monolithic `docker`
    // client with no buildx plugin, so force the daemon's embedded
    // BuildKit explicitly rather than relying on it being the default.
    DOCKER_BUILDKIT = '1'
    // Per-build Docker config dir. Jenkins is one container shared by every
    // build-<svc> job, so a single ~/.docker/config.json means one build's
    // post-stage `docker logout` yanks the login out from under any other
    // build still mid-push (seen live: "insufficient_scope" on a valid
    // token). $WORKSPACE is per-job and disableConcurrentBuilds() keeps it
    // to one run, so this is unique per concurrent build.
    DOCKER_CONFIG = "${WORKSPACE}/.docker-cfg"
  }

  options {
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'ENVIRONMENT', choices: ['local', 'prod'], description: 'Which k8s/environments/<env> to update')
    string(name: 'SERVICES', defaultValue: 'identity-service', description: 'Comma-separated service names, or "all"')
    string(name: 'WEB_API_URL', defaultValue: '', description: 'Overrides web\'s NEXT_PUBLIC_API_URL build-arg')
  }

  stages {
    stage('Checkout source repo') {
      steps {
        // Public repo — anonymous clone, no credential needed for read.
        dir('src') {
          git branch: SOURCE_BRANCH, url: SOURCE_REPO_URL
        }
      }
    }

    stage('Load environment') {
      steps {
        // Plain shell parsing rather than the readProperties step, to avoid
        // needing the pipeline-utility-steps plugin on top of the minimal
        // plugin set this setup needs.
        script {
          def propsFile = "jenkins/env/${params.ENVIRONMENT}.properties"
          env.AWS_REGION          = sh(script: "grep '^AWS_REGION='          ${propsFile} | cut -d= -f2-", returnStdout: true).trim()
          env.ECR_REGISTRY        = sh(script: "grep '^ECR_REGISTRY='        ${propsFile} | cut -d= -f2-", returnStdout: true).trim()
          // Falls back to ECR_REGISTRY when unset (e.g. prod, where the push
          // address and the pull address are the same real ECR endpoint).
          env.ECR_PUSH_REGISTRY   = sh(script: "grep '^ECR_PUSH_REGISTRY=' ${propsFile} | cut -d= -f2-", returnStdout: true).trim() ?: env.ECR_REGISTRY
          env.K8S_ENV             = sh(script: "grep '^K8S_ENV='             ${propsFile} | cut -d= -f2-", returnStdout: true).trim()
          env.DOCKERHUB_REPO      = sh(script: "grep '^DOCKERHUB_REPO='      ${propsFile} | cut -d= -f2-", returnStdout: true).trim()
          // The image tag must track the *source* repo's commit, not this
          // (platform-gitops) repo's — GIT_COMMIT here would be the latter.
          env.GIT_SHA = sh(script: "git -C src rev-parse --short=8 HEAD", returnStdout: true).trim()
        }
        // Local (not --global) repo config, set once — needed by every git
        // operation that creates a commit, including the rebase replay in
        // the push-retry loop below, not just the explicit `git commit`
        // call (confirmed: a per-command `-c user.name=...` on just the
        // commit step left `git rebase` with no identity when a concurrent
        // push forced a retry, failing with "unable to auto-detect email").
        sh '''
          git config user.name jenkins
          git config user.email jenkins@ai-notification.local
        '''
        // One `docker login` for the whole run — the tag-bump-only `prod`
        // path still benefits (harmless no-op if never pushing). Credential
        // seeded into Jenkins' store at boot (platform-infrastructure
        // templates/jenkins/init-security.groovy.tftpl).
        withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh '''
            mkdir -p "$DOCKER_CONFIG"
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
          '''
        }
      }
    }

    stage('Build + push (one service at a time)') {
      steps {
        script {
          def requested = params.SERVICES.trim() == 'all'
            ? SERVICE_CATALOG.keySet() as List
            : params.SERVICES.split(',').collect { it.trim() }

          for (svc in BUILD_ORDER) {
            if (!requested.contains(svc)) {
              continue
            }
            def cfg = SERVICE_CATALOG[svc]
            // Push address (host-published port of the Floci registry) --
            // NOT env.ECR_REGISTRY, which is the in-cluster pull address a
            // Mac-side `docker push` can't route to (Docker Desktop won't
            // reach a custom bridge's container IPs). Same registry/blobs.
            def ecrPushImage = "${env.ECR_PUSH_REGISTRY}/${svc}:${env.GIT_SHA}"
            // One shared Docker Hub repo, service in the tag (see
            // DOCKERHUB_REPO in local.properties for why not 13 repos).
            def hubImage = "${env.DOCKERHUB_REPO}:${svc}-${env.GIT_SHA}"
            def buildArgFlags = cfg.buildArgs.collect { k, v -> "--build-arg ${k}=${v}" }.join(' ')

            // Both tags in one build so the two pushes are the same bytes.
            // `-f` is CWD-relative (not context-relative like kaniko was);
            // the catalog's dockerfile paths already include the 'src/'
            // prefix, and the context is a real path in this container's
            // workspace (the dir('src') checkout above) — `docker build`
            // streams that context to the daemon over the socket, so it
            // doesn't matter that $JENKINS_HOME is a named volume.
            // --provenance/--sbom off: buildx would otherwise push an OCI
            // image index with attestation manifests, which the plain
            // registry:2 behind Floci ECR can reject.
            sh """
              docker build \
                -f ${cfg.dockerfile} \
                ${buildArgFlags} \
                --provenance=false --sbom=false \
                -t ${hubImage} \
                -t ${ecrPushImage} \
                ${cfg.context}
            """

            // Docker Hub first — the durable copy. Non-negotiable; a
            // failure after the retries fails the build. Retried because
            // Docker Hub can briefly 429 / return a transient auth error
            // under load.
            sh """
              for attempt in 1 2 3 4 5; do
                if docker push ${hubImage}; then
                  break
                fi
                if [ "\$attempt" = "5" ]; then
                  echo "Docker Hub push failed after 5 attempts" >&2
                  exit 1
                fi
                echo "Docker Hub push attempt \$attempt failed — retrying in 15s"
                sleep 15
              done
            """

            // Floci ECR second. Retry a few times -- Floci provisions its
            // registry lazily and this project has hit registry churn
            // repeatedly (see platform-infrastructure notes).
            sh """
              for attempt in 1 2 3 4 5; do
                if docker push ${ecrPushImage}; then
                  break
                fi
                if [ "\$attempt" = "5" ]; then
                  echo "ECR push failed after 5 attempts — ${hubImage} is safe on Docker Hub; re-run once the Floci ECR registry is reachable." >&2
                  exit 1
                fi
                echo "ECR push attempt \$attempt failed — retrying in 10s"
                sleep 10
              done
            """

            // Free the local layer store — 13 full NestJS images on an 8GB
            // Mac otherwise fills the Docker Desktop VM disk mid-run. The
            // registries hold the real copies now.
            sh "docker image rm ${hubImage} ${ecrPushImage} || true"

            def valuesFile = "k8s/environments/${env.K8S_ENV}/values-${svc}.yaml"
            // schemaHash: a content hash of this service's own
            // prisma/schema.prisma, written into values.database.schemaHash
            // — the nest-service chart's migrate-job.yaml embeds it in the
            // PreSync migrate Job's own name, so a build with an unchanged
            // schema (the common case) produces the same Job name+spec as
            // last time, which ArgoCD's next sync re-applies as a no-op
            // instead of re-running `prisma migrate deploy`. Only
            // computed/written when a schema.prisma actually exists for
            // this service. Every database.enabled=true values file already
            // has a schemaHash: placeholder line committed, so this only
            // ever updates an existing line, never inserts.
            def schemaFile = "src/apps/${svc}/prisma/schema.prisma"
            sh """
              sed -i "s|^\\(\\s*repository:\\).*|\\1 ${env.ECR_REGISTRY}/${svc}|" ${valuesFile}
              sed -i "s|^\\(\\s*tag:\\).*|\\1 \\"${env.GIT_SHA}\\"|" ${valuesFile}
              if [ -f "${schemaFile}" ]; then
                SCHEMA_HASH=\$(sha256sum "${schemaFile}" | cut -c1-12)
                sed -i "s|^\\(\\s*schemaHash:\\).*|\\1 \\"\$SCHEMA_HASH\\"|" ${valuesFile}
              fi
              git add ${valuesFile}
              # No-op when the values file is already at this repo+tag+hash
              # (a re-run of an already-built service, or a rebuild at the
              # same source commit) -- that's success, not a build failure.
              if git diff --cached --quiet -- ${valuesFile}; then
                echo "${valuesFile} already current for ${svc} @ ${env.GIT_SHA} -- nothing to commit."
              else
                git commit -m "ci: bump image tag for ${svc} to ${env.GIT_SHA}"
              fi
            """
          }
        }
      }
    }

    stage('Push tag-bump commits') {
      steps {
        // github-push credential is seeded automatically into Jenkins' own
        // credential store at startup — nothing manual needed here.
        //
        // Rebase-and-retry rather than a bare push: this branch can move
        // between checkout and push (another build, or a human pushing
        // directly), so a bare push racing that would fail outright.
        withCredentials([usernamePassword(credentialsId: 'github-push', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
          sh '''
            REMOTE="https://${GIT_USER}:${GIT_TOKEN}@github.com/dip7501686040/platform-gitops.git"
            for attempt in 1 2 3 4 5; do
              if git push "$REMOTE" HEAD:main; then
                exit 0
              fi
              echo "push rejected (attempt $attempt) — rebasing onto latest main and retrying"
              git fetch "$REMOTE" main
              git rebase FETCH_HEAD
            done
            echo "push still failing after 5 attempts"
            exit 1
          '''
        }
      }
    }
  }

  post {
    always {
      // Only touches this build's own DOCKER_CONFIG, not a shared one.
      sh 'docker logout || true; rm -rf "$DOCKER_CONFIG" || true'
    }
  }
}
