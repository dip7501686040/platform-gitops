# Copy to aws.env and fill in real values before running:
#   kubectl create secret generic app-secrets --from-env-file=infra/k8s/secrets/aws.env -n ai-notification
#
# RABBITMQ_URL must embed the same password as RABBITMQ_PASSWORD (used by
# the rabbitmq StatefulSet itself, see infra/k8s/charts/backing-services).
# DATABASE_URL per service is composed in the nest-service chart from
# POSTGRES_PASSWORD via Kubernetes' $(VAR) env substitution — don't set it
# here directly.

JWT_SECRET=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://notification:<same-as-RABBITMQ_PASSWORD>@rabbitmq:5672
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SMTP_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_SECRET=
